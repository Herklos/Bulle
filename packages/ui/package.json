{
  "name": "@bulle/ui",
  "version": "0.1.0",
  "description": "Bulle's design system — tokens, motion, the orb and the fil.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "react-native": "./src/theme/index.ts",
      "require": "./src/theme/index.ts",
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./primitives": {
      "source": "./src/primitives/index.ts",
      "react-native": "./src/primitives/index.ts",
      "require": "./src/primitives/index.ts",
      "import": "./dist/primitives/index.js",
      "types": "./dist/primitives/index.d.ts"
    },
    "./components": {
      "source": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "require": "./src/components/index.ts",
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./utils/kv-storage": {
      "browser": "./src/utils/kv-storage.web.ts",
      "react-native": "./src/utils/kv-storage.ts",
      "source": "./src/utils/kv-storage.ts",
      "require": "./src/utils/kv-storage.ts",
      "import": "./dist/utils/kv-storage.js",
      "types": "./dist/utils/kv-storage.d.ts"
    },
    "./utils/secure-store": {
      "source": "./src/utils/secure-store.ts",
      "react-native": "./src/utils/secure-store.ts",
      "require": "./src/utils/secure-store.ts",
      "import": "./dist/utils/secure-store.js",
      "types": "./dist/utils/secure-store.d.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --skipLibCheck || true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo-haptics": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "peerDependenciesMeta": {
    "@expo/ui": { "optional": true },
    "@react-native-async-storage/async-storage": { "optional": true },
    "@shopify/react-native-skia": { "optional": true },
    "expo-haptics": { "optional": true },
    "expo-secure-store": { "optional": true },
    "expo-sqlite": { "optional": true },
    "react-native-safe-area-context": { "optional": true },
    "react-native-svg": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "tsup": "^8.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  }
}
