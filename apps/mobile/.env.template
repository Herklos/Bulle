# Copy to .env.local (or export in your shell) for local `expo start` / `pnpm ios` / `pnpm android`.
# Every var below has a working fallback in code, so this file is optional for local dev —
# it exists to document what's read and where. EAS builds get their values from eas.json's
# per-profile "env" instead (see apps/mobile/eas.json), not from this file.

# Starfish sync server. No trailing /v1. Placeholder default does not resolve — see lib/config.ts.
EXPO_PUBLIC_SYNC_BASE=

# Public origin used to build invite links that open in a browser.
EXPO_PUBLIC_APP_ORIGIN=

# RevenueCat public SDK keys, one per store (see lib/revenuecat.ts). Falls back to the
# RevenueCat Test Store key when unset. Public keys — safe to commit, not secret.
EXPO_PUBLIC_REVENUECAT_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_KEY_WEB=

# Pins "today" for the blog-publish-date gate (lib/blog-publish-dates.ts). CI/tests only —
# leave unset for local dev, where it falls back to the real current date.
BUILD_DATE=
