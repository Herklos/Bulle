{
  "name": "bulle",
  "version": "0.1.0",
  "private": true,
  "description": "Votre bulle à deux avant l'arrivée de bébé. Application privée, locale et hors ligne pour préparer l'arrivée d'un bébé à deux.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "expo install --check",
    "build:web": "expo export --platform web && node scripts/generate-sitemap.mjs"
  },
