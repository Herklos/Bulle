{
  "name": "bulle-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "//build:web": "Cloudflare Pages runs its build command from the REPO ROOT, so it needs this passthrough — `pnpm -r build:web` fails with 'Command build:web not found' because only apps/mobile defines it.",
    "build:web": "pnpm --filter bulle build:web",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.10"
  }
}
